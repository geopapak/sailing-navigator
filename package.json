{
  "name": "sailing-navigator",
  "private": true,
  "version": "0.18.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:staging": "tsc --noEmit && vite build --mode staging",
    "build:e2e": "tsc --noEmit && tsc --noEmit -p e2e && node e2e/build.mjs",
    "preview": "vite preview --host",
    "test": "vitest run && vitest run --config e2e/vitest.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "icons": "node scripts/make-icons.mjs",
    "changelog": "node scripts/changelog.mjs",
    "reset-password": "node scripts/reset-password.mjs",
    "make-admin": "node scripts/make-admin.mjs",
    "pentest": "node scripts/pentest-local.mjs",
    "e2e": "npm run build:e2e && playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --project=chromium-375 --headed",
    "e2e:report": "playwright show-report e2e/.out/report"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "maplibre-gl": "^6.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
